{
	"v2raya-helper": {
		"description": "Read v2rayA status and latency history",
		"read": {
			"ubus": {
				"v2raya-helper": [ "status", "latency" ]
			}
		}
	},
	"v2raya-helper-settings": {
		"description": "Read what this router runs and allow changes for an unverified v2rayA version",
		"read": {
			"ubus": {
				"v2raya-helper": [ "environment" ]
			},
			"uci": [ "v2raya_helper" ]
		},
		"write": {
			"uci": [ "v2raya_helper" ]
		}
	},
	"v2raya-helper-routing": {
		"description": "Read and edit v2rayA RoutingA rules and restart its Xray core",
		"read": {
			"ubus": {
				"v2raya-helper": [ "routing_context", "routing_preview" ]
			}
		},
		"write": {
			"ubus": {
				"v2raya-helper": [ "routing_save", "routing_restart" ]
			}
		}
	},
	"v2raya-helper-failover": {
		"description": "Read and configure v2rayA automatic server switching",
		"read": {
			"ubus": {
				"v2raya-helper": [ "failover_context", "status", "latency" ]
			}
		},
		"write": {
			"ubus": {
				"v2raya-helper": [ "failover_save" ]
			}
		}
	},
	"v2raya-helper-geodata": {
		"description": "Read and manage Xray geodata",
		"read": {
			"ubus": {
				"v2raya-helper": [ "geodata_status" ]
			}
		},
		"write": {
			"ubus": {
				"v2raya-helper": [ "geodata_start" ]
			}
		}
	}
}
