#!/bin/sh

# Sets api, local_api and config: where v2rayA answers and where its core config lives.
locate_api() {
	local address
	local_api=
	api="$(uci -q get v2raya_helper.main.api)"
	if [ -z "$api" ]; then
		local_api=1
		address="$(uci -q get v2raya.config.address)"
		address="${address:-0.0.0.0:2017}"
		case "$address" in
			0.0.0.0:*|:*|localhost:*) address="127.0.0.1:${address##*:}" ;;
			'[::]:'*) address="[::1]:${address##*:}" ;;
		esac
		api="http://$address"
	fi
	config="$(uci -q get v2raya_helper.main.xray_config)"
	config="${config:-/etc/v2raya/config.json}"
}

run_helper() {
	local api local_api config token_file state_file environment core assets
	locate_api
	token_file="$(uci -q get v2raya_helper.main.token_file)"
	V2RAYA_HELPER_ALLOW_UNVERIFIED="$(uci -q get v2raya_helper.main.allow_unverified)"
	export V2RAYA_HELPER_ALLOW_UNVERIFIED
	umask 077
	case "$1" in
		environment) exec /usr/bin/v2raya-helper env "$api" "$config" ;;
		routing)
			# The lock lives in the daemon's private directory, which may not exist yet.
			mkdir -p -m 700 /var/run/v2raya-helper
			state_file=/var/run/v2raya-helper/routing.lock ;;
		failover) state_file=/etc/config/v2raya-helper-failover.json ;;
	esac
	if [ "$1" = routing ] && [ "$2" != restart ] && [ "$local_api" = 1 ]; then
		# The running core of v2rayA, whatever its binary is called, and its geo files.
		environment="$(/usr/bin/v2raya-helper env "$api" "$config")"
		core="$(printf '%s' "$environment" | jsonfilter -e '@.core.binary' 2>/dev/null)"
		assets="$(printf '%s' "$environment" | jsonfilter -e '@.core.assets' 2>/dev/null)"
		case "$core:$assets" in
			/*:/*) [ -x "$core" ] && [ -d "$assets" ] &&
				exec /usr/bin/v2raya-helper "$1" "$2" "$api" "$token_file" "$state_file" "$core" "$assets" ;;
		esac
	fi
	exec /usr/bin/v2raya-helper "$1" "$2" "$api" "$token_file" "$state_file"
}

# The GeoData job validates with the core v2rayA runs and its asset directory.
run_geodata() {
	local api local_api config environment
	locate_api
	environment="$(/usr/bin/v2raya-helper env "$api" "$config")"
	V2RAYA_HELPER_CORE="$(printf '%s' "$environment" | jsonfilter -e '@.core.binary' 2>/dev/null)"
	V2RAYA_HELPER_CORE_VARIANT="$(printf '%s' "$environment" | jsonfilter -e '@.variant' 2>/dev/null)"
	V2RAYA_HELPER_ASSETS="$(printf '%s' "$environment" | jsonfilter -e '@.core.assets' 2>/dev/null)"
	V2RAYA_HELPER_CONFIG="$config"
	export V2RAYA_HELPER_CORE V2RAYA_HELPER_CORE_VARIANT V2RAYA_HELPER_ASSETS V2RAYA_HELPER_CONFIG
	exec /usr/libexec/v2raya-helper-geodata start "$1"
}

case "$1" in
	list)
		printf '%s\n' '{"status":{},"environment":{},"latency":{"outbound":""},"routing_context":{},"routing_preview":{"kind":"","value":"","outbound":"","before_line":0,"revision":""},"routing_save":{"kind":"","value":"","outbound":"","before_line":0,"revision":""},"routing_restart":{"confirm":false},"failover_context":{},"failover_save":{"policy":{}},"geodata_status":{},"geodata_start":{"action":""}}'
		;;
	call)
		case "$2" in
			latency) exec /usr/bin/v2raya-helper latency-rpc /var/run/v2raya-helper/latency.json ;;
			environment) run_helper environment ;;
			routing_context) run_helper routing context ;;
			routing_preview) run_helper routing preview ;;
			routing_save) run_helper routing save ;;
			routing_restart) run_helper routing restart ;;
			failover_context) run_helper failover context ;;
			failover_save) run_helper failover save ;;
			geodata_status) exec /usr/libexec/v2raya-helper-geodata status ;;
			geodata_start)
				action="$(jsonfilter -e '@.action' 2>/dev/null)"
				case "$action" in
					update|restore) run_geodata "$action" ;;
					*) printf '%s\n' '{"ok":false,"error":"Unknown geodata action"}' ;;
				esac
				exit 0
				;;
			status) ;;
			*) exit 3 ;;
		esac
		printf '{"router_unix":%s,"snapshot":' "$(date +%s)"
		if [ -r /var/run/v2raya-helper/status.json ]; then
			cat /var/run/v2raya-helper/status.json || exit 1
		else
			printf '%s' '{"state":"starting","outbounds":[]}'
		fi
		printf '}\n'
		;;
	*) exit 3 ;;
esac
