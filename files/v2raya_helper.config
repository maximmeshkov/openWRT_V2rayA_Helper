config monitor 'main'
	# Leave unset to use the listen address from v2raya.config.address.
	# option api 'http://127.0.0.1:2017'
	# Set explicitly alongside a manual API URL when both refer to the same core.
	# option xray_config '/etc/v2raya/config.json'
	option interval '10'
	option timeout '3'
	option workers '2'
	option mark '0x80'
	# One HTTPS target shared by all assigned nodes. The default expects HTTP 204.
	# option node_url 'https://cp.cloudflare.com/generate_204'
	# option node_code '204'
	# option node_interval '60'
	# option node_timeout '8'
	# Servers other than plain SOCKS5/HTTP proxies are checked through a separate,
	# short-lived copy of v2rayA's core. Set a binary here only if the helper
	# cannot find the running core itself.
	# option probe_core '/usr/bin/xray'
	# option token_file '/etc/v2raya-helper.token'
	# option login_file '/etc/v2raya-helper-login.json'
	# Server switching, RoutingA saving and crashed-core start are verified for
	# v2rayA 2.2.6.7-2.2.7.5 with Xray. To use them on another version at your
	# own risk, name that exact version; a v2rayA upgrade turns this off again.
	# option allow_unverified '2.5.16'
	# option recover_xray '1'
	# option restore_lan_redirect '1'
	# option observatory 'http://127.0.0.1:39179/debug/vars'
	# option observatory_max_age '60'
