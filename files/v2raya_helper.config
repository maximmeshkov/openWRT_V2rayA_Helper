config monitor 'main'
	# Leave unset to use the listen address from v2raya.config.address.
	# option api 'http://127.0.0.1:2017'
	# Set explicitly alongside a manual API URL when both refer to the same core.
	# option xray_config '/etc/v2raya/config.json'
	option interval '10'
	option timeout '3'
	option workers '2'
	option mark '0x80'
	# One HTTPS target shared by all assigned nodes. The default expects HTTP 204.
	# option node_url 'https://cp.cloudflare.com/generate_204'
	# option node_code '204'
	# option node_interval '60'
	# option node_timeout '8'
	# option token_file '/etc/v2raya-helper.token'
	# option observatory 'http://127.0.0.1:39179/debug/vars'
	# option observatory_max_age '60'
